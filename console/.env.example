# Base URL of the Memora FastAPI backend.
# NEXT_PUBLIC_ is required: the console calls the API from the browser, so this
# value is inlined into the client bundle. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Only needed if the backend has ADMIN_API_KEY set. Note that this reaches the
# browser, so it is a guard against casual access, not a real secret. A console
# exposed beyond localhost needs proper operator sign-in instead.
NEXT_PUBLIC_ADMIN_API_KEY=

# The public API reference (memora.x.in/docs). The console links out to it
# rather than hosting documentation behind the login.
NEXT_PUBLIC_DOCS_URL=http://localhost:3001/docs

# Google sign-in, the only way into the console. The OAuth *client ID* from
# Google Cloud Console > APIs & Services > Credentials (a Web application
# client); the same value goes in backend/.env as GOOGLE_CLIENT_ID. The client
# secret is not used and must never go here: NEXT_PUBLIC_ values ship to the
# browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
