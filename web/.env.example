# Where the console lives. Every "use Memora" call to action on this site is a
# link into it -- this site never performs an operation itself.
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000

# Base URL of the Memora API, shown in the reference's code samples so a reader
# can copy one and run it unchanged.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
