# ---------------------------------------------------------------------------
# Memora backend configuration. Copy to backend/.env and fill in.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# local      : build.nvidia.com for every model, files on local disk (STORAGE_DIR)
# production : Nebius for text models, files in Cloudflare R2 (R2_* below)
# Nebius has no NVIDIA vision, parse, embedding or rerank model, so those
# calls use build.nvidia.com in both environments: production needs BOTH keys.
ENVIRONMENT=local

# Neon PostgreSQL connection string.
# Grab it from the Neon console > Project > Connection Details, then swap the
# driver prefix to `postgresql+psycopg://` so SQLAlchemy uses psycopg 3.
#   postgresql+psycopg://USER:PASSWORD@ep-xxx.region.aws.neon.tech/memora?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/memora

# Secret used to HMAC API tokens before they are stored.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every issued API credential.
API_SECRET=change-me-in-production

# Signs console session cookies (JWT HS256). Without it the default
# "change-me-in-production" is used -- never deploy with that.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=VnCDvIzG5-1ZAzdSVBs7CwG93iYxTdxwvtrtbr3GLGI0184UQ9L0w9mkKyl4GLT9

# ENVIRONMENT=local: where uploaded source files are written on disk.
STORAGE_DIR=./var/storage

# ENVIRONMENT=production: Cloudflare R2 bucket (R2 > Manage API Tokens).
# The endpoint looks like https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=memora-documents

# Comma-separated browser origins allowed to call the API.
# Both loopback spellings are listed because they are distinct origins to the
# browser: opening the console on 127.0.0.1 while only localhost is allowed
# fails every request with a CORS error and no obvious cause.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Extraction Agent -- NVIDIA models only (docs/extraction-agent.md)
# ---------------------------------------------------------------------------
# The provider follows ENVIRONMENT (see the top of this file).

# Key from https://build.nvidia.com (profile > API keys), starts with nvapi-
NVIDIA_API_KEY=
# Key from https://tokenfactory.nebius.com (used only when ENVIRONMENT=production)
NEBIUS_API_KEY=

# One model per role. Every id MUST start with nvidia/ or the app refuses to
# start. Ids can differ between platforms -- list them first with
#   curl -H "Authorization: Bearer $KEY" <base_url>/models
LLM_EXTRACT_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Layout and vision always run on build.nvidia.com (Nebius has neither).
LLM_LAYOUT_MODEL=nvidia/nemotron-parse

# Model prices are NOT set here: they live in backend/pricing.json, the
# operator's versioned price list (see docs/extraction-agent.md, "Cost").
# Override the location only if you keep it elsewhere:
# PRICING_FILE=/etc/memora/pricing.json

# Limits and page-triage thresholds (defaults shown).
EXTRACTION_MAX_PAGES=30
EXTRACTION_MAX_IMAGES=20
EXTRACTION_CONCURRENCY=4
TRIAGE_MIN_TEXT_CHARS=200
TRIAGE_IMAGE_RATIO=0.15

# ---------------------------------------------------------------------------
# Knowledge graph -- FalkorDB (docs/graph-rag.md)
# ---------------------------------------------------------------------------
# FalkorDB Cloud: take host, port, username and password from the instance's
# "Connect" panel. falkors:// is TLS, falkor:// plain (local). Leave empty to
# run without the graph: graph endpoints then answer 503, nothing else changes.
FALKORDB_URL=
# FALKORDB_URL=falkors://USERNAME:PASSWORD@HOST:PORT
# One graph per tenant is created as <prefix>_tenant_<tenant uuid>.
FALKORDB_GRAPH_PREFIX=memora

# The NVIDIA model that reads each chunk for entities and relationships.
LLM_GRAPH_MODEL=nvidia/nemotron-3-super-120b-a12b

# Chunking and limits (defaults shown). A build makes one model call per chunk.
GRAPH_CHUNK_CHARS=3000
GRAPH_CHUNK_OVERLAP=300
GRAPH_CONCURRENCY=4
GRAPH_MAX_CHUNKS=200
GRAPH_FUZZY_THRESHOLD=92

# Entity / relationship types live in backend/ontology.json (versioned, like
# pricing.json). Override the location only if you keep it elsewhere:
# GRAPH_ONTOLOGY_FILE=/etc/memora/ontology.json

# Tests: point graph tests at a FalkorDB (e.g. the same Cloud instance; tests
# use their own random graph prefix and delete their graphs afterwards).
# TEST_FALKORDB_URL=falkors://USERNAME:PASSWORD@HOST:PORT
